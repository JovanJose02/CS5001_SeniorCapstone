dth="405" height="78" as="geometry"/></mxCell><mxCell id="n_SB2" value="&lt;b&gt;Sublessee student&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#bf9000;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="25" y="340" width="100" height="80" as="geometry"/></mxCell><mxCell id="n_C1b" value="&lt;b&gt;C1 Web Client&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#1f4e79;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="225" y="345" width="90" height="70" as="geometry"/></mxCell><mxCell id="n_C6" value="&lt;b&gt;C6 Messaging Service&lt;/b&gt;&lt;br&gt;verified threads" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#1f4e79;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="415" y="345" width="140" height="70" as="geometry"/></mxCell><mxCell id="n_TH" value="&lt;b&gt;E3 Thread and message rows&lt;/b&gt;&lt;br&gt;(also owner copy rows)" style="shape=partialRectangle;whiteSpace=wrap;html=1;left=0;right=0;fillColor=#d5e8d4;strokeColor=#4f7a28;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="655" y="345" width="140" height="70" as="geometry"/></mxCell><mxCell id="n_N2" value="&lt;b&gt;Timing budgets and rules&lt;/b&gt;&lt;br&gt;Sender must be verified (token claim). The listing must be PUBLISHED in C6's owner copy, which arrives on I16. Body is 1 to 2000 characters.&lt;br&gt;If the alert cannot be queued, the message is still stored (I11 error path)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#bf9000;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="850" y="320" width="405" height="88" as="geometry"/></mxCell><mxCell id="n_C2" value="&lt;b&gt;C2 Identity Service&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#1f4e79;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x=