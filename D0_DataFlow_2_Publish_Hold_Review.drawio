s="geometry"/></mxCell><mxCell id="n_ST" value="&lt;b&gt;E3 Listing and outbox rows&lt;/b&gt;&lt;br&gt;(C3 schema: listing rows and event rows)" style="shape=partialRectangle;whiteSpace=wrap;html=1;left=0;right=0;fillColor=#d5e8d4;strokeColor=#4f7a28;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="393" y="395" width="145" height="225" as="geometry"/></mxCell><mxCell id="n_C5" value="&lt;b&gt;C5 Search &amp;amp; Match&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#1f4e79;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="400" width="120" height="60" as="geometry"/></mxCell><mxCell id="n_C6" value="&lt;b&gt;C6 Messaging Service&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#1f4e79;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="480" width="120" height="60" as="geometry"/></mxCell><mxCell id="n_C7" value="&lt;b&gt;C7 Approval Service&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#1f4e79;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="560" width="120" height="60" as="geometry"/></mxCell><mxCell id="n_IDX" value="&lt;b&gt;E3 Search index rows&lt;/b&gt;" style="shape=partialRectangle;whiteSpace=wrap;html=1;left=0;right=0;fillColor=#d5e8d4;strokeColor=#4f7a28;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="820" y="405" width="120" height="50" as="geometry"/></mxCell><mxCell id="n_CPY" value="&lt;b&gt;E3 Owner copy rows&lt;/b&gt;" style="shape=partialRectangle;whiteSpace=wrap;html=1;left=0;right=0;fillColor=#d5e8d4;strokeColor=#4f7a28;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="820" y="485" width="120" height="50" as="geometry"/></mxCell><mxCell id="n_C8" value="&lt;b&gt;C8 Notification Service&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#1f4e79;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="820" y="560" width="120" height="60" as="geometry"/></mxCell><mxCell id="n_E1" value="&lt;b&gt;E1 Email Delivery API&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 3;fillColor=#eeeeee;strokeColor=#666666;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1020" y="560" width="90" height="60" as="geometry"/></mxCell><mxCell id="n_E2" value="&lt;b&gt;E2 Recipient Mailboxes&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 3;fillColor=#eeeeee;strokeColor=#666666;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1170" y="560" width="90" height="60" as="geometry"/></mxCell><mxCell id="n_PM" value="&lt;b&gt;Property manager&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#bf9000;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1170" y="435" width="90" height="75" as="geometry"/></mxCell><mxCell id="n_N1" value="&lt;b&gt;Timing budgets and rules&lt;/b&gt;&lt;br&gt;AC-01.1 search: submit to visible in a verified student's search within 60 s. The outbox relay polls every 5 s; worst case about 41 s (5 s poll, retries at 5 s and 30 s).&lt;br&gt;AC-01.1 notice: submit to manager email within 5 min. Worst case about 3.6 min (5 s poll, send retries at 30, 60, 120 s).&lt;br&gt;AC-01.3: a HELD_FOR_REVIEW row emits no event, so it returns 0 search results. Releasing it in review writes the same events (the clock restarts at release).&lt;br&gt;AC-01.4: invalid dates or rent are rejected by C3 before any row is written. If C4 is down, C3 holds the listing (I7 fails closed).&lt;br&gt;I8, I16, I9 are delivered by C3's outbox relay from its event rows in E3, one event per consumer." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#bf9000;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="700" y="105" width="555" height="160" as="geometry"/></mxCell><mxCell id="n_lg_box" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#bf9000;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="25" y="655" width="820" height="122" as="geometry"/></mxCell><mxCell id="n_lg_a" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#bf9000;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="685" width="32" height="20" as="geometry"/></mxCell><mxCell id="n_lg_c" value="" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#1f4e79;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="717" width="32" height="20" as="geometry"/></mxCell><mxCell id="n_lg_e" value="" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 3;fillColor=#eeeeee;strokeColor=#666666;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="749" width="32" height="20" as="geometry"/></mxCell><mxCell id="n_lg_s" value="" style="shape=partialRectangle;whiteSpace=wrap;html=1;left=0;right=0;fillColor=#d5e8d4;strokeColor=#4f7a28;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="435" y="685" width="32" height="20" as="geometry"/></mxCell><mxCell id="n_lg_n" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#bf9000;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="435" y="749" width="32" height="20" as="geometry"/></mxCell><mxCell id="t_0" value="Verified Student Sublease Marketplace | Data Flow 2 (UC-01 steps 7 to 10, US-01, US-05): publish, hold, or review a listing" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18.5;fontColor=#000000;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="25" y="10" width="1230" height="26.95" as="geometry"/></mxCell><mxCell id="t_1" value="Goal: Let UC students fill or find term-length subleases safely by limiting the marketplace to verified @mail.uc.edu students, matching listings to exact co-op dates, holding discriminatory listings for review, and giving property managers an approve/reject step before move-in." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="25" y="36" width="1230" height="33.7" as="geometry"/></mxCell><mxCell id="t_2" value="Actor: a person who uses the system" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="82" y="685" width="340" height="17.5" as="geometry"/></mxCell><mxCell id="t_3" value="Component we design and build (Cn)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="82" y="717" width="340" height="17.5" as="geometry"/></mxCell><mxCell id="t_4" value="External system we depend on but do not build (En)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="82" y="749" width="340" height="17.5" as="geometry"/></mxCell><mxCell id="t_5" value="Data store: rows at rest in E3 (each component has its own schema)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="477" y="685" width="360" height="17.5" as="geometry"/></mxCell><mxCell id="t_6" value="Data flow. The label gives the data crossing it, its form at that point, and the interface Ix it travels on (Part 4)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="477" y="713" width="360" height="31" as="geometry"/></mxCell><mxCell id="t_7" value="Note box: timing budgets and rules from the requirements" style="text;html=1;whiteSpace=wrap;align=left;vertica