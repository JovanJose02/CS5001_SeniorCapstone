eee;strokeColor=#666666;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1075" y="520" width="160" height="100" as="geometry"/></mxCell><mxCell id="n_E3" value="&lt;b&gt;E3 Managed SQL Database&lt;/b&gt;&lt;br&gt;hosted SQL, one schema per component" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 3;fillColor=#eeeeee;strokeColor=#666666;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="780" y="805" width="320" height="60" as="geometry"/></mxCell><mxCell id="n_lg_box" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#bf9000;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="25" y="773" width="740" height="128" as="geometry"/></mxCell><mxCell id="n_lg_a" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#bf9000;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="803" width="32" height="20" as="geometry"/></mxCell><mxCell id="n_lg_c" value="" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#1f4e79;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="835" width="32" height="20" as="geometry"/></mxCell><mxCell id="n_lg_e" value="" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 3;fillColor=#eeeeee;strokeColor=#666666;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="867" width="32" height="20" as="geometry"/></mxCell><mxCell id="n_lg_b" value="" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=1 3;fillColor=none;strokeColor=#1f4e79;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="390" y="803" width="32" height="20" as="geometry"/></mxCell><mxCell id="n_lg_b2" value="" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=1 3;fillColor=none;strokeColor=#1f4e79;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="390" y="865" width="32" height="8" as="geometry"/></mxCell><mxCell id="t_0" value="Verified Student Sublease Marketplace | Design D0: Block Diagram" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18.5;fontColor=#000000;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="25" y="10" width="1230" height="26.95" as="geometry"/></mxCell><mxCell id="t_1" value="Goal: Let UC students fill or find term-length subleases safely by limiting the marketplace to verified @mail.uc.edu students, matching listings to exact co-op dates, holding discriminatory listings for review, and giving property managers an approve/reject step before move-in." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="25" y="36" width="1230" height="33.7" as="geometry"/></mxCell><mxCell id="t_2" value="Backend: one deployable, modular monolith (C2 to C8)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#1f4e79;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="432" y="139" width="560" height="18.175" as="geometry"/></mxCell><mxCell id="t_3" value="Actor: a person who uses the system" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="82" y="803" width="290" height="17.5" as="geometry"/></mxCell><mxCell id="t_4" value="Component we design and build (Cn)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="82" y="835" width="290" height="17.5" as="geometry"/></mxCell><mxCell id="t_5" value="External system we depend on but do not build (En)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="82" y="867" width="290" height="17.5" as="geometry"/></mxCell><mxCell id="t_6" value="Deployment boundary: C2 to C8 run in one deployable backend" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="432" y="803" width="300" height="17.5" as="geometry"/></mxCell><mxCell id="t_7" value="Interface Ix (Part 4), from caller to callee; the reply returns on it. Double-headed: both sides initiate." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="432" y="835" width="300" height="31" as="geometry"/></mxCell><mxCell id="t_8" value="Arrow from the boundary: interface used by each component inside that Part 4 lists for it." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="432" y="867" width="300" height="31" as="geometry"/></mxCell><mxCell id="e_0" value="I1 UI" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;fontColor=#8b1a1a;labelBackgroundColor=#ffffff;startArrow=block;startFill=1;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.4364;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_Users" target="n_C1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_1" value="I2 auth" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;fontColor=#8b1a1a;labelBackgroundColor=#ffffff;startArrow=none;exitX=1.0000;exitY=0.0636;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_C1" target="n_C2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_2" value="I6 approvals" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;fontColor=#8b1a1a;labelBackgroundColor=#ffffff;startArrow=none;exitX=1.0000;exitY=0.2818;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_C1" target="n_C7"><mxGeometry relative="1