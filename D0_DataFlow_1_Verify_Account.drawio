Space=wrap;html=1;fillColor=#fffbe6;strokeColor=#bf9000;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="885" y="320" width="370" height="128" as="geometry"/></mxCell><mxCell id="n_lg_box" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#bf9000;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="25" y="505" width="820" height="122" as="geometry"/></mxCell><mxCell id="n_lg_a" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#bf9000;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="535" width="32" height="20" as="geometry"/></mxCell><mxCell id="n_lg_c" value="" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#1f4e79;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="567" width="32" height="20" as="geometry"/></mxCell><mxCell id="n_lg_e" value="" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 3;fillColor=#eeeeee;strokeColor=#666666;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="599" width="32" height="20" as="geometry"/></mxCell><mxCell id="n_lg_s" value="" style="shape=partialRectangle;whiteSpace=wrap;html=1;left=0;right=0;fillColor=#d5e8d4;strokeColor=#4f7a28;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="435" y="535" width="32" height="20" as="geometry"/></mxCell><mxCell id="n_lg_n" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#bf9000;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="435" y="599" width="32" height="20" as="geometry"/></mxCell><mxCell id="t_0" value="Verified Student Sublease Marketplace | Data Flow 1 (UC-01 steps 2 to 6, US-01): verify a student account" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fon