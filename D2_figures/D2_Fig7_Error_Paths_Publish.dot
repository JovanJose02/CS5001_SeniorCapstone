digraph D2_Fig7_Error_Paths_Publish {
  graph [fontname="Inter", rankdir=TB, labelloc=t, labeljust=l, nodesep=0.3, ranksep=0.5, pad=0.2, label=<<TABLE BORDER="0" CELLPADDING="1" CELLSPACING="0"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14"><B>Verified Student Sublease Marketplace</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12.5"><B>D2 Figure 7: error paths in the riskiest flow, publish a listing and fan out its events (US-01, US-05, AC-01.1, AC-01.3, AC-01.4)</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">Goal: Let UC students fill or find term-length subleases safely by limiting the marketplace to<BR ALIGN="LEFT"/>verified @mail.uc.edu students, matching listings to exact co-op dates, holding discriminatory<BR ALIGN="LEFT"/>listings for review, and giving property managers an approve/reject step before move-in.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#444444"><B>Conventions: </B>Rounded box = processing step (owning component in brackets). Diamond = decision. Black arrows = happy path. Red<BR ALIGN="LEFT"/>arrows and red boxes = error paths, each ending in the stated outcome; R = recoverable (user or system can<BR ALIGN="LEFT"/>retry), N = not recoverable without a person. Dashed arrow = asynchronous hand-off through an outbox or queue<BR ALIGN="LEFT"/>row. Codes are HTTP status + error code.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD> </TD></TR></TABLE>> , nodesep=0.35, ranksep=0.35];
  node [fontname="Inter", fontsize=11];
  edge [fontname="Inter", fontsize=10, color="#333333"];
  node [shape=box, style="rounded,filled", fillcolor="#DCE6F5", color="#3B5B92", fontsize=11];
  start [shape=circle, label="", width=0.2, style=filled, fillcolor=black];
  a1 [label="POST /api/v1/listings\n[C1 -> C3, I3a]"];
  d1 [shape=diamond, style=filled, fillcolor="#FFF6DC", color="#8A6D00", label="token valid?\n[G1]", fontsize=10];
  x1 [shape=box, style="rounded,filled", fillcolor="#FDECEA", color="#B3261E", fontcolor="#B3261E", label="401 UNAUTHENTICATED\nC1 restarts sign-in, R", fontsize=10];
  d2 [shape=diamond, style=filled, fillcolor="#FFF6DC", color="#8A6D00", label="verified and\nfresh (12 mo)?", fontsize=10];
  x2 [shape=box, style="rounded,filled", fillcolor="#FDECEA", color="#B3261E", fontcolor="#B3261E", label="403 VERIFICATION_REQUIRED\nC1 starts I2, draft kept, R", fontsize=10];
  d3 [shape=diamond, style=filled, fillcolor="#FFF6DC", color="#8A6D00", label="input valid?\n[zod, C3]", fontsize=10];
  x3 [shape=box, style="rounded,filled", fillcolor="#FDECEA", color="#B3261E", fontcolor="#B3261E", label="400 INVALID_INPUT\nno row (AC-01.4), R", fontsize=10];
  a2 [label="normalize address\n[C3]"];
  a3 [label="screen(text)\n[C4, I7, 2 s budget]"];
  d4 [shape=diamond, style=filled, fillcolor="#FFF6DC", color="#8A6D00", label="C4 result?", fontsize=10];
  h1 [shape=box, style="rounded,filled", fillcolor="#FFF6DC", color="#8A6D00", label="HELD_FOR_REVIEW\nno outbox rows\n(flagged or SCREENER_UNAVAILABLE)", fontsize=10];
  a4 [label="BEGIN TX: insert Listing PUBLISHED\n+ 3 ListingEvent rows (C5, C6, C7)"];
  d5 [shape=diamond, style=filled, fillcolor="#FFF6DC", color="#8A6D00", label="commit ok?", fontsize=10];
  x4 [shape=box, style="rounded,filled", fillcolor="#FDECEA", color="#B3261E", fontcolor="#B3261E", label="409 DUPLICATE_LISTING\n(partial unique index), R", fontsize=10];
  x5 [shape=box, style="rounded,filled", fillcolor="#FDECEA", color="#B3261E", fontcolor="#B3261E", label="503 DB_UNAVAILABLE\nTX rolled back, Retry-After 5, R", fontsize=10];
  r1 [shape=box, style="rounded,filled", fillcolor="#E6F2E6", color="#2E7D32", label="201 {listingId, status,\nflaggedPhrases}", fontsize=10];
  a5 [label="outbox relay, every 5 s\nSKIP LOCKED, per row [C3]"];
  d6 [shape=diamond, style=filled, fillcolor="#FFF6DC", color="#8A6D00", label="consumer\nhandler ok?", fontsize=10];
  a6 [label="retry +5 s, +30 s, +2 min\nper row, others unaffected"];
  x6 [shape=box, style="rounded,filled", fillcolor="#FDECEA", color="#B3261E", fontcolor="#B3261E", label="FAILED after 4th attempt\nERROR log + redrive script\nAC-01.1 at risk, N", fontsize=10];
  r2 [shape=box, style="rounded,filled", fillcolor="#E6F2E6", color="#2E7D32", label="C5 index row\n(upsert if version newer)", fontsize=10];
  r2b [shape=box, style="rounded,filled", fillcolor="#E6F2E6", color="#2E7D32", label="C6 owner copy row\n(upsert if version newer)", fontsize=10];
  a7 [label="C7: upsert ListingCopy,\nlookup UnitRegistry"];
  d7 [shape=diamond, style=filled, fillcolor="#FFF6DC", color="#8A6D00", label="unit\nregistered?", fontsize=10];
  h2 [shape=box, style="rounded,filled", fillcolor="#EEEEEE", color="#666666", label="UNREGISTERED_UNIT, ack,\nno notice; listing stays\npublished (degrade), R", fontsize=10];
  a8 [label="enqueue NEW_LISTING\n[C8, I12]"];
  a9 [label="C8 worker sends\n[I13, 5 s timeout]"];
  d8 [shape=diamond, style=filled, fillcolor="#FFF6DC", color="#8A6D00", label="E1 result?", fontsize=10];
  a10 [label="retry +30 s, +60 s, +120 s"];
  x7 [shape=box, style="rounded,filled", fillcolor="#FDECEA", color="#B3261E", fontcolor="#B3261E", label="FAILED (4xx or 4th attempt)\nERROR log, R by redrive", fontsize=10];
  x8 [shape=box, style="rounded,filled", fillcolor="#FDECEA", color="#B3261E", fontcolor="#B3261E", label="BOUNCED webhook\nSuppression row, N", fontsize=10];
  r3 [shape=box, style="rounded,filled", fillcolor="#E6F2E6", color="#2E7D32", label="manager email\n<= 5 min (AC-01.1)", fontsize=10];
  start -> a1 -> d1;
  d1 -> x1 [color="#B3261E", fontcolor="#B3261E", label="no"];
  d1 -> d2 [label="yes"];
  d2 -> x2 [color="#B3261E", fontcolor="#B3261E", label="no"];
  d2 -> d3 [label="yes"];
  d3 -> x3 [color="#B3261E", fontcolor="#B3261E", label="no"];
  d3 -> a2 [label="yes"]; a2 -> a3 -> d4;
  d4 -> h1 [color="#B3261E", fontcolor="#B3261E", label="flagged, throws,\nor > 2 s"];
  d4 -> a4 [label="clean"]; a4 -> d5;
  d5 -> x4 [color="#B3261E", fontcolor="#B3261E", label="unique\nviolation"];
  d5 -> x5 [color="#B3261E", fontcolor="#B3261E", label="connection\nlost"];
  d5 -> r1 [label="yes"];
  r1 -> a5 [style=dashed, label="async", constraint=false]; a5 -> d6;
  d6 -> a6 [color="#B3261E", fontcolor="#B3261E", label="throws"];
  a6 -> a5 [style=dashed];
  a6 -> x6 [color="#B3261E", fontcolor="#B3261E", label="4th failure"];
  d6 -> r2 [label="C5"]; d6 -> r2b [label="C6"]; d6 -> a7 [label="C7"];
  a7 -> d7;
  d7 -> h2 [color="#B3261E", fontcolor="#B3261E", label="no"];
  d7 -> a8 [label="yes"]; a8 -> a9 [style=dashed]; a9 -> d8;
  d8 -> a10 [color="#B3261E", fontcolor="#B3261E", label="5xx / 429 /\ntimeout"];
  a10 -> a9 [style=dashed];
  a10 -> x7 [color="#B3261E", fontcolor="#B3261E", label="4th failure"];
  d8 -> x7 [color="#B3261E", fontcolor="#B3261E", label="4xx"];
  d8 -> r3 [label="2xx"];
  r3 -> x8 [color="#B3261E", fontcolor="#B3261E", label="later bounce"];
  {rank=same; d1; x1}
  {rank=same; d2; x2}
  {rank=same; d3; x3}
  {rank=same; d4; h1}
}
