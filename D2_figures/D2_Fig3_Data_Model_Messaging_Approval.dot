digraph D2_Fig3_Data_Model_Messaging_Approval {
  graph [fontname="Inter", rankdir=TB, labelloc=t, labeljust=l, nodesep=0.3, ranksep=0.5, pad=0.2, label=<<TABLE BORDER="0" CELLPADDING="1" CELLSPACING="0"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14"><B>Verified Student Sublease Marketplace</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12.5"><B>D2 Figure 3: data model for C6 Messaging and C7 Approval</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">Goal: Let UC students fill or find term-length subleases safely by limiting the marketplace to<BR ALIGN="LEFT"/>verified @mail.uc.edu students, matching listings to exact co-op dates, holding discriminatory<BR ALIGN="LEFT"/>listings for review, and giving property managers an approve/reject step before move-in.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#444444"><B>Conventions: </B>Rounded box = entity in the schema of the component named in its title. Dashed box = transient object, never<BR ALIGN="LEFT"/>stored. Solid line = foreign key inside one component&#x27;s schema. Dotted line = logical reference by ID to another<BR ALIGN="LEFT"/>component&#x27;s data (no cross-schema FK; kept current by events or the I17a/I17b lookups). Cardinality at both<BR ALIGN="LEFT"/>ends: 1, 0..1, 0..*, 1..*. [PK] primary key, [FK] foreign key, [UQ] unique, [UQ*] partial unique index, trailing<BR ALIGN="LEFT"/>? = nullable. Datetimes UTC; money integer cents.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD> </TD></TR></TABLE>> ];
  node [fontname="Inter", fontsize=11];
  edge [fontname="Inter", fontsize=10, color="#333333"];
  lc6 [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" STYLE="rounded" BGCOLOR="#E0F2F1" COLOR="#555555"><TR><TD ALIGN="LEFT" COLSPAN="2" BGCOLOR="#E0F2F1"><B>ListingCopy (C6-owned, from I16)</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10">listing_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5">UUID [PK]</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10">owner_user_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10">address_summary</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5">string</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10">source_version</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5">int</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10">updated_at</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5">datetime</FONT></TD></TR></TABLE>>];
  thr [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" STYLE="rounded" BGCOLOR="#E0F2F1" COLOR="#555555"><TR><TD ALIGN="LEFT" COLSPAN="2" BGCOLOR="#E0F2F1"><B>Thread (C6-owned)</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10">thread_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5">UUID [PK]</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10">listing_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5">UUID [FK]</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10">owner_user_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10">sublessee_user_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10">created_at</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5">datetime</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10">last_message_at</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5">datetime</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10">owner_alerted_at</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5">datetime?</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10">sublessee_alerted_at</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5">datetime?</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10">[UQ]</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5">(listing_id, sublessee_user_id)</FONT></TD></TR></TABLE>>];
  msg [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" STYLE="rounded" BGCOLOR="#E0F2F1" COLOR="#555555"><TR><TD ALIGN="LEFT" COLSPAN="2" BGCOLOR="#E0F2F1"><B>Message (C6-owned)</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10">message_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5">UUID [PK]</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10">thread_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5">UUID [FK]</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10">sender_user_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10">client_message_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10">body</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5">string (1..2000)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10">sent_at</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5">datetime</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10">[UQ]</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5">(sender_user_id, client_message_id)</FONT></TD></TR></TABLE>>];
  unit [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" STYLE="rounded" BGCOLOR="#FFF6DC" COLOR="#555555"><TR><TD ALIGN="LEFT" COLSPAN="2" BGCOLOR="#FFF6DC"><B>UnitRegistry (C7-owned, team-seeded)</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10">address_norm</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5">string [PK]</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10">manager_user_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10">unit_label</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5">string</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10">seeded_at</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5">datetime</FONT></TD></TR></TABLE>>];
  lc7 [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" STYLE="rounded" BGCOLOR="#FFF6DC" COLOR="#555555"><TR><TD ALIGN="LEFT" COLSPAN="2" BGCOLOR="#FFF6DC"><B>ListingCopy (C7-owned, from I9)</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10">listing_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5">UUID [PK]</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10">owner_user_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10">address_norm</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5">string [FK]?</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10">available_start</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5">date</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10">available_end</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5">date</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10">unit_status</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5">enum {REGISTERED, UNREGISTERED_UNIT}</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10">source_version</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5">int</FONT></TD></TR></TABLE>>];
  apr [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" STYLE="rounded" BGCOLOR="#FFF6DC" COLOR="#555555"><TR><TD ALIGN="LEFT" COLSPAN="2" BGCOLOR="#FFF6DC"><B>ApprovalRequest (C7-owned)</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10">request_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5">UUID [PK]</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10">listing_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5">UUID [FK]</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10">owner_user_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10">sublessee_user_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10">manager_user_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10">status</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5">enum {PENDING, APPROVED, REJECTED}</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10">reason</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5">string? (1..500)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10">created_at</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5">datetime</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10">decided_at</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5">datetime?</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10">reminder_sent_at</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5">datetime?</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10">[UQ*]</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5">(listing_id) WHERE status IN</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10"> </FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5">  (PENDING, APPROVED)</FONT></TD></TR></TABLE>>];
  acct [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" STYLE="rounded" BGCOLOR="#E3EAF6" COLOR="#555555"><TR><TD ALIGN="LEFT" COLSPAN="2" BGCOLOR="#E3EAF6"><B>Account (C2-owned, see Fig. 2)</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10">user_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5">UUID [PK]</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10">role, verified</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5">read via token / I17b</FONT></TD></TR></TABLE>>];
  lst [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" STYLE="rounded" BGCOLOR="#E6F2E6" COLOR="#555555"><TR><TD ALIGN="LEFT" COLSPAN="2" BGCOLOR="#E6F2E6"><B>Listing (C3-owned, see D1 Fig. 1)</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10">listing_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5">UUID [PK]</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10">version</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5">int</FONT></TD></TR></TABLE>>];
  lc6 -> thr [arrowhead=none, taillabel="1", headlabel="0..*", fontcolor="#B3261E"];
  thr -> msg [arrowhead=none, taillabel="1", headlabel="1..*", fontcolor="#B3261E"];
  unit -> lc7 [arrowhead=none, taillabel="0..1", headlabel="0..*", fontcolor="#B3261E"];
  lc7 -> apr [arrowhead=none, taillabel="1", headlabel="0..*", fontcolor="#B3261E"];
  lst -> lc6 [style=dotted, arrowhead=vee, label="copied by I16\n(upsert if version newer)", taillabel="1", headlabel="0..1", fontcolor="#B3261E"];
  lst -> lc7 [style=dotted, arrowhead=vee, label="copied by I9", taillabel="1", headlabel="0..1", fontcolor="#B3261E"];
  apr -> acct [style=dotted, arrowhead=vee, label="owner, sublessee,\nmanager ids (I17b)", taillabel="0..*", headlabel="1", fontcolor="#B3261E"];
  thr -> acct [style=dotted, arrowhead=vee, label="participant ids", taillabel="0..*", headlabel="1", fontcolor="#B3261E"];
  {rank=same; lc6; lc7}
  {rank=same; thr; apr}
}
