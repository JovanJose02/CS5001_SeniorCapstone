digraph D2_Fig2_Data_Model_Identity_Notify {
  graph [fontname="Inter", rankdir=LR, labelloc=t, labeljust=l, nodesep=0.3, ranksep=0.5, pad=0.2, label=<<TABLE BORDER="0" CELLPADDING="1" CELLSPACING="0"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14"><B>Verified Student Sublease Marketplace</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12.5"><B>D2 Figure 2: data model for C2 Identity, C8 Notification, and G3 audit</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">Goal: Let UC students fill or find term-length subleases safely by limiting the marketplace to<BR ALIGN="LEFT"/>verified @mail.uc.edu students, matching listings to exact co-op dates, holding discriminatory<BR ALIGN="LEFT"/>listings for review, and giving property managers an approve/reject step before move-in.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#444444"><B>Conventions: </B>Rounded box = entity in the schema of the component named in its title. Dashed box = transient object, never<BR ALIGN="LEFT"/>stored. Solid line = foreign key inside one component&#x27;s schema. Dotted line = logical reference by ID to another<BR ALIGN="LEFT"/>component&#x27;s data (no cross-schema FK; kept current by events or the I17a/I17b lookups). Cardinality at both<BR ALIGN="LEFT"/>ends: 1, 0..1, 0..*, 1..*. [PK] primary key, [FK] foreign key, [UQ] unique, [UQ*] partial unique index, trailing<BR ALIGN="LEFT"/>? = nullable. Datetimes UTC; money integer cents.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD> </TD></TR></TABLE>> ];
  node [fontname="Inter", fontsize=11];
  edge [fontname="Inter", fontsize=10, color="#333333"];
  acct [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" STYLE="rounded" BGCOLOR="#E3EAF6" COLOR="#555555"><TR><TD ALIGN="LEFT" COLSPAN="2" BGCOLOR="#E3EAF6"><B>Account (C2-owned)</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10">user_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5">UUID [PK]</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10">email</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5">string [UQ], lowercased</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10">role</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5">enum {STUDENT, MANAGER, REVIEWER}</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10">status</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5">enum {UNVERIFIED, PENDING, VERIFIED}</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10">verified_at</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5">datetime?</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10">first_name</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5">string?</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10">seeded</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5">bool</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10">created_at</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5">datetime</FONT></TD></TR></TABLE>>];
  link [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" STYLE="rounded" BGCOLOR="#E3EAF6" COLOR="#555555"><TR><TD ALIGN="LEFT" COLSPAN="2" BGCOLOR="#E3EAF6"><B>LoginLink (C2-owned)</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10">link_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5">UUID [PK]</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10">user_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5">UUID [FK]</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10">token_hash</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5">bytea [UQ], SHA-256</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10">issued_at</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5">datetime</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10">expires_at</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5">datetime (issued+24h)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10">used_at</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5">datetime?</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10">superseded_at</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5">datetime?</FONT></TD></TR></TABLE>>];
  claims [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" STYLE="rounded,dashed" BGCOLOR="#F5F5F5" COLOR="#555555"><TR><TD ALIGN="LEFT" COLSPAN="2" BGCOLOR="#F5F5F5"><B>SessionClaims (C2 -&gt; G1, transient)</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10">sub</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5">UUID (user_id)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10">role</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5">enum</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10">verified</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5">bool</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10">verifiedAt</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5">datetime?</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10">iat, exp</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5">int (exp = iat+24h)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10">kid</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5">string (JWT header)</FONT></TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT POINT-SIZE="9.5" COLOR="#555555"><I>Signed HS256 JWT; never stored server-side.</I></FONT></TD></TR></TABLE>>];
  notif [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" STYLE="rounded" BGCOLOR="#F8EADF" COLOR="#555555"><TR><TD ALIGN="LEFT" COLSPAN="2" BGCOLOR="#F8EADF"><B>Notification (C8-owned)</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10">notification_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5">UUID [PK]</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10">idempotency_key</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5">string [UQ]</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10">template_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5">enum {LOGIN_LINK, NEW_MESSAGE,</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10"> </FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5">  NEW_LISTING, SUBLEASE_PROPOSED,</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10"> </FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5">  DECISION, REMINDER}</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10">priority</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5">smallint (1 = LOGIN_LINK)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10">to_user_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10">to_email</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5">string</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10">params</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5">JSONB (typed per template)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10">status</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5">enum {QUEUED, SENDING, SENT,</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10"> </FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5">  DELIVERED, BOUNCED, FAILED, SUPPRESSED}</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10">attempts</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5">int (0..4)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10">next_attempt_at</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5">datetime</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10">provider_msg_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5">string? [UQ]</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10">last_error</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5">string?</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10">created_at</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5">datetime</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10">updated_at</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5">datetime</FONT></TD></TR></TABLE>>];
  supp [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" STYLE="rounded" BGCOLOR="#F8EADF" COLOR="#555555"><TR><TD ALIGN="LEFT" COLSPAN="2" BGCOLOR="#F8EADF"><B>Suppression (C8-owned)</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10">email</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5">string [PK]</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10">reason</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5">enum {BOUNCED, COMPLAINT}</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10">created_at</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5">datetime</FONT></TD></TR></TABLE>>];
  hook [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" STYLE="rounded" BGCOLOR="#F8EADF" COLOR="#555555"><TR><TD ALIGN="LEFT" COLSPAN="2" BGCOLOR="#F8EADF"><B>WebhookReceipt (C8-owned)</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10">provider_event_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5">string [PK]</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10">notification_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5">UUID [FK]</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10">event</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5">enum {DELIVERED, DEFERRED, BOUNCED}</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10">received_at</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5">datetime</FONT></TD></TR></TABLE>>];
  req [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" STYLE="rounded,dashed" BGCOLOR="#F5F5F5" COLOR="#555555"><TR><TD ALIGN="LEFT" COLSPAN="2" BGCOLOR="#F5F5F5"><B>NotificationRequest (I10/I11/I12, transient)</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10">templateId</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5">enum</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10">toUserId</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10">params</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5">typed per templateId</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10">idempotencyKey</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5">string</FONT></TD></TR></TABLE>>];
  audit [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" STYLE="rounded" BGCOLOR="#EEEEEE" COLOR="#555555"><TR><TD ALIGN="LEFT" COLSPAN="2" BGCOLOR="#EEEEEE"><B>AuditLog (G3-owned, append-only)</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10">audit_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5">bigint [PK]</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10">at</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5">datetime</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10">actor_user_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10">action</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5">enum {ACCOUNT_VERIFIED, LISTING_RELEASED,</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10"> </FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5">  LISTING_REJECTED, APPROVAL_DECIDED,</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10"> </FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5">  NOTIFICATION_REDRIVEN}</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10">entity_type</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5">string</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10">entity_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5">UUID</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10">request_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5">string</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10">detail</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10.5">JSONB (no PII)</FONT></TD></TR></TABLE>>];
  acct -> link [arrowhead=none, taillabel="1", headlabel="0..*", fontcolor="#B3261E"];
  notif -> hook [arrowhead=none, taillabel="1", headlabel="0..*", fontcolor="#B3261E"];
  notif -> acct [style=dotted, arrowhead=vee, label="to_user_id\n(resolved via I17a)", taillabel="0..*", headlabel="1", fontcolor="#B3261E", constraint=false];
  notif -> supp [style=dotted, arrowhead=vee, label="to_email checked\nat enqueue", taillabel="0..*", headlabel="0..1", fontcolor="#B3261E"];
  audit -> acct [style=dotted, arrowhead=vee, label="actor_user_id", taillabel="0..*", headlabel="1", fontcolor="#B3261E"];
  acct -> claims [style=dashed, arrowhead=vee, label="issued on confirm", taillabel="1", headlabel="0..*", fontcolor="#B3261E"];
  req -> notif [style=dashed, arrowhead=vee, label="enqueue() inserts\n(ON CONFLICT key: existing row)", taillabel="1", headlabel="1", fontcolor="#B3261E"];
  {rank=same; acct; audit}
  {rank=same; req; notif}
}
