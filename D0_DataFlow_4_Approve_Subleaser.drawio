 parent="1"><mxGeometry x="480" y="110" width="140" height="80" as="geometry"/></mxCell><mxCell id="n_RJ" value="&lt;b&gt;C7 reminder check&lt;/b&gt;&lt;br&gt;daily job" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#1f4e79;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="720" y="115" width="100" height="70" as="geometry"/></mxCell><mxCell id="n_C8" value="&lt;b&gt;C8 Notification Service&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#1f4e79;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="720" y="260" width="100" height="80" as="geometry"/></mxCell><mxCell id="n_C2" value="&lt;b&gt;C2 Identity Service&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#1f4e79;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="700" y="410" width="140" height="70" as="geometry"/></mxCell><mxCell id="n_E1" value="&lt;b&gt;E1 Email Delivery API&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 3;fillColor=#eeeeee;strokeColor=#666666;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="890" y="265" width="80" height="70" as="geometry"/></mxCell><mxCell id="n_E2" value="&lt;b&gt;E2 Recipient Mailboxes&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 3;fillColor=#eeeeee;strokeColor=#666666;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1030" y="265" width="80" height="70" as="geometry"/></mxCell><mxCell id="n_PM1" value="&lt;b&gt;Property manager&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#bf9000;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1180" y="210" width="90" height="70" as="geometry"/></mxCell><mxCell id="n_BS" value="&lt;b&gt;Both students&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#bf9000;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1180" y="360" width="90" height="70" as="geometry"/></mxCell><mxCell id="n_N1" value="&lt;b&gt;Timing budgets and rules&lt;/b&gt;&lt;br&gt;AC-02.1: approval sets status APPROVED with a timestamp and both students are emailed within 5 min (worst case about 3.5 min: send retries at 30, 60, 120 s).&lt;br&gt;AC-02.2: no manager response in 5 business days sends exactly 1 reminder (the daily check runs after day 5; the reminderSent flag blocks a second). The subleaser sees status Pending.&lt;br&gt;State: each request is in exactly one of PENDING, APPROVED, REJECTED; a second decision returns 409. A unit with no registered manager skips the notice (UNREGISTERED_UNIT)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#bf9000;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="860" y="440" width="400" height="135" as="geometry"/></mxCell><mxCell id="n_lg_box" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#bf9000;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="25" y="598" width="820" height="122" as="geometry"/></mxCell><mxCell id="n_lg_a" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#bf9000;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="628" width="32" height="20" as="geometry"/></mxCell><mxCell id="n_lg_c" value="" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#1f4e79;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="660" width="32" height="20" as="geometry"/></mxCell><mxCell id="n_lg_e" value="" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 3;fillColor=#eeeeee;strokeColor=#666666;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="692" width="32" height="20" as="geometry"/></mxCell><mxCell id="n_lg_s" value="" style="shape=partialRectangle;whiteSpace=wrap;html=1;left=0;right=0;fillColor=#d5e8d4;strokeColor=#4f7a28;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="435" y="628" width="32" height="20" as="geometry"/></mxCell><mxCell id="n_lg_n" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#bf9000;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="435" y="692" width="32" height="20" as="geometry"/></mxCell><mxCell id="t_0" value="Verified Student Sublease Marketplace | Data Flow 4 (UC-02, US-03): approve or reject a proposed subleaser" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18.5;fontColor=#000000;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="25" y="10" width="1230" height="26.95" as="geometry"/></mxCell><mxCell id="t_1" value="Goal: Let UC students fill or find term-length subleases safely by limiting the marketplace to verified @mail.uc.edu students, matching listings to exact co-op dates, holding discriminatory listings for review, and giving property managers an approve/reject step before move-in." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="25" y="36" width="1230" height="33.7" as="geometry"/></mxCell><mxCell id="t_2" value="Actor: a person who uses the system" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="82" y="628" width="340" height="17.5" as="geometry"/></mxCell><mxCell id="t_3" value="Component we design and build (Cn)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="82" y="660" width="340" height="17.5" as="geometry"/></mxCell><mxCell id="t_4" value="External system we depend on but do not build (En)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="82" y="692" width="340" height="17.5" as="geometry"/></mxCell><mxCell id="t_5" value="Data store: rows at rest in E3 (each component has its own schema)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="477" y="628" width="360" height="17.5" as="geometry"/></mxCell><mxCell id="t_6" value="Data flow. The label gives the data crossing it, its form at that point, and the interface Ix it travels on (Part 4)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="477" y="656" width="360" height="31" as="geometry"/></mxCell><mxCell id="t_7" value="Note box: timing budgets and rules from the requirements" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="477" y="692" width="360" height="17.5" as="geometry"/></mxCell><mxCell id="e_0" value="proposed&lt;br&gt;sublessee&lt;br&gt;(selection)&lt;br&gt;· I1" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;fontColor=#8b1a1a;labelBackgroundColor=#ffffff;startArrow=none;exitX=1.0000;exitY=0.3667;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.3286;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_SS" target="n_C1a"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_1" value="status&lt;br&gt;(HTML)&lt;br&gt;· I1" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;fontColor=#8b1a1a;labelBackgroundColor=#ffffff;startArrow=none;exitX=0.0000;exitY=0.6714;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.6333;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_C1a" target="n_SS"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_2" value="proposal {listingId,&lt;br&gt;sublesseeUserId}&l